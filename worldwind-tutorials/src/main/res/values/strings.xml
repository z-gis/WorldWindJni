<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">WorldWind 教程演示</string>

    <!-- 主页菜单 -->
    <string name="menu_subtitle">worldwindjni 功能演示 · 逐项点击体验</string>

    <string name="demo_basic_title">01 · 瓦片底图</string>
    <string name="demo_basic_desc">内置 worldtopobathy 世界底图（不棋盘）+ 可开关在线详细；相机定位北京，单击看经纬度</string>
    <string name="demo_globe_title">02 · 2D / 3D 视图切换</string>
    <string name="demo_globe_desc">平面墨卡托与 3D 球体切换；3D 下双指可旋转/俯仰</string>
    <string name="demo_vector_title">03 · 矢量图层与拾取</string>
    <string name="demo_vector_desc">读取内置 GeoJSON（面+标注）；单击拾取要素并高亮</string>
    <string name="demo_overlay_title">04 · 动态叠加层绘制</string>
    <string name="demo_overlay_desc">单击加点，实时绘制折线/多边形叠加层（测量口径）</string>
    <string name="demo_marker_title">05 · 定位标记（蓝点）</string>
    <string name="demo_marker_desc">模拟 1Hz 定位回调移动蓝点，带方向箭头</string>
    <string name="demo_srs_title">06 · 坐标转换（PROJ）</string>
    <string name="demo_srs_desc">WGS84 ↔ Web Mercator 任意坐标系互转</string>

    <!-- 通用操作 -->
    <string name="action_2d">2D</string>
    <string name="action_3d">3D</string>
    <string name="action_add_vector">加载矢量层</string>
    <string name="action_toggle_line_polygon">切换：多边形</string>
    <string name="action_undo">撤销点</string>
    <string name="action_clear">清空</string>
    <string name="action_start_move">开始移动</string>
    <string name="action_stop_move">停止移动</string>
    <string name="action_convert">转换</string>

    <string name="srs_hint_lon">经度（lon）</string>
    <string name="srs_hint_lat">纬度（lat）</string>
    <string name="srs_src">源坐标系</string>
    <string name="srs_tgt">目标坐标系</string>
</resources>
